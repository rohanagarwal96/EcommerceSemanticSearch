# Qdrant. Leave QDRANT_URL empty for local venv-based dev/tests -- this
# cleanly skips the real-Qdrant integration/e2e tests, since they gate on
# `not QDRANT_URL`. Set it to http://localhost:6333 once `docker compose up
# -d qdrant` is running (see docker-compose.yml) to point scripts/tests at
# it, or point QDRANT_URL/QDRANT_API_KEY at a cloud cluster instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ecommerce_products
QDRANT_IMAGE_COLLECTION_NAME=ecommerce_products_images

# Vector search backend: "faiss" for local dev/tests (default), "qdrant" to
# use the Qdrant container from docker-compose.yml instead.
VECTOR_BACKEND=faiss

# Kaggle (only needed if not relying on ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key_here
